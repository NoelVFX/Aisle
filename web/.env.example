# Copy to .env.local (gitignored).

# REQUIRED for real products: the app pulls live Shopify products (title, price, image, sku)
# from Agnic's catalogue. Without it, browse honestly says "connect Agnic" and shows nothing
# rather than fabricating products. Get it from https://app.agnic.ai (server-side only).
AGNIC_TOKEN=
# Market for product search: US, GB, CA or AU. Defaults to US.
# AGNIC_DEFAULT_COUNTRY=US
# AGNIC_BASE_URL=https://api.agnic.ai


# Makes the chat genuinely intelligent: general questions ("what's my vaulted card?",
# "did it actually pay?") are answered by an OpenRouter LLM instead of a canned line.
# Without a key, the app still works but only answers scripted shopping intents.
OPENROUTER_API_KEY=

# Chat model (any OpenRouter model your key can use). Defaults to deepseek/deepseek-chat-v3.1.
# AISLE_CHAT_MODEL=deepseek/deepseek-chat-v3.1


# Supabase auth (optional; enables accounts + synced profiles).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL used for the email-confirmation link, so it never points at localhost even
# when you sign up from a local dev server. Set this to your deployed domain (no trailing
# slash), e.g. https://aisle.vercel.app. Must match Supabase Auth "Site URL" and be in the
# Redirect URLs allowlist. Falls back to the current origin when unset.
NEXT_PUBLIC_SITE_URL=
