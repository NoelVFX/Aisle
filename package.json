{
  "name": "aisle",
  "version": "0.1.0",
  "description": "Agentic Checkout: an MCP agent that completes a purchase through almost any merchant's existing checkout — WebMCP fast lane, local Playwright slow lane — with one human approval. No merchant integration required.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gateway": "tsx src/gateway/server.ts",
    "login": "tsx src/gateway/login.ts",
    "gateway:http": "tsx src/gateway/http-server.ts",
    "vendor:studio": "tsx src/demo-vendor/launch.ts"
  },
  "keywords": [
    "agentic-checkout",
    "webmcp",
    "mcp",
    "agent",
    "playwright",
    "payments",
    "checkout"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright-core": "^1.48.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
