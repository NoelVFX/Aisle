{
  "name": "top-up-agent",
  "version": "0.1.0",
  "description": "Fast-lane transaction recovery for coding agents: detect a vendor's WebMCP purchase tools, buy the minimum entitlement, verify it, and hand back a resume token.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx src/demo.ts"
  },
  "keywords": [
    "webmcp",
    "mcp",
    "agent",
    "payments",
    "entitlement",
    "recovery"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
