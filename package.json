{
  "name": "top-up-agent",
  "version": "0.1.0",
  "description": "Fast-lane transaction recovery for coding agents: detect a vendor's WebMCP purchase tools, buy the minimum entitlement, verify it, and hand back a resume token.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:steel": "node --env-file=.env --import tsx src/steel-smoke.ts",
    "gateway": "tsx src/gateway/server.ts",
    "steel:login": "tsx src/gateway/steel-login.ts",
    "gateway:http": "tsx src/gateway/http-server.ts",
    "vendor:studio": "tsx src/demo-vendor/launch.ts"
  },
  "keywords": [
    "webmcp",
    "mcp",
    "agent",
    "payments",
    "entitlement",
    "recovery"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright-core": "^1.48.2",
    "steel-sdk": "^0.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
