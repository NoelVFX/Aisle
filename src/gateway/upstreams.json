{
  "openrouter": {
    "description": "OpenRouter. An account with no credits gets 402 Insufficient credits on paid models, from the API (openrouter__chat with OPENROUTER_DEMO_KEY) or from openrouter.ai/chat in the browser. After approval Aisle buys the credits on /settings/credits in a Steel browser, using the card saved on the account.",
    "canonicalOrigin": "https://openrouter.ai",
    "billingOrigin": "https://openrouter.ai",
    "billingUrl": "https://openrouter.ai/settings/credits",
    "authEnv": "OPENROUTER_DEMO_KEY",
    "resource": "usd_balance",
    "purchase": {
      "mode": "slow-lane",
      "realMoney": true,
      "pricingPath": "/settings/credits",
      "accountPath": "/settings/credits",
      "loginWallPattern": "^/(sign-in|sign-up|login)",
      "offersFrom": "catalogue",
      "paymentOrigins": [
        "https://checkout.stripe.com"
      ],
      "steelCredentials": true
    },
    "offers": [
      {
        "productId": "openrouter_credits_5",
        "label": "$5 credits",
        "unitsGranted": 5,
        "price": 5,
        "currency": "USD",
        "billing": "one_time",
        "autoRenew": false
      },
      {
        "productId": "openrouter_credits_10",
        "label": "$10 credits",
        "unitsGranted": 10,
        "price": 10,
        "currency": "USD",
        "billing": "one_time",
        "autoRenew": false
      },
      {
        "productId": "openrouter_credits_25",
        "label": "$25 credits",
        "unitsGranted": 25,
        "price": 25,
        "currency": "USD",
        "billing": "one_time",
        "autoRenew": false
      }
    ]
  },
  "openai": {
    "description": "OpenAI API. A key on an account with no credits returns 429 insufficient_quota / credit_balance_exhausted, a real billing wall.",
    "canonicalOrigin": "https://api.openai.com",
    "billingOrigin": "https://platform.openai.com",
    "billingUrl": "https://platform.openai.com/settings/organization/billing/overview",
    "authEnv": "OPENAI_API_KEY",
    "resource": "usd_balance",
    "purchase": {
      "mode": "slow-lane",
      "realMoney": true,
      "pricingPath": "/settings/organization/billing/overview",
      "accountPath": "/settings/organization/billing/overview",
      "loginWallPattern": "^/(login|log-in|signin|auth)",
      "offersFrom": "catalogue",
      "paymentOrigins": [
        "https://checkout.stripe.com"
      ]
    },
    "offers": [
      {
        "productId": "openai_credits_5",
        "label": "$5 API credits",
        "unitsGranted": 5,
        "price": 5,
        "currency": "USD",
        "billing": "one_time",
        "autoRenew": false
      },
      {
        "productId": "openai_credits_10",
        "label": "$10 API credits",
        "unitsGranted": 10,
        "price": 10,
        "currency": "USD",
        "billing": "one_time",
        "autoRenew": false
      },
      {
        "productId": "openai_credits_25",
        "label": "$25 API credits",
        "unitsGranted": 25,
        "price": 25,
        "currency": "USD",
        "billing": "one_time",
        "autoRenew": false
      }
    ]
  },
  "higgsfield": {
    "description": "Higgsfield image generation through the Higgsfield Cloud API. The pricing page offers one-time 100, 200, and 500 image-credit packs.",
    "canonicalOrigin": "https://api.higgsfield.ai",
    "billingOrigin": "https://higgsfield.ai",
    "billingUrl": "https://higgsfield.ai/pricing",
    "authEnv": "HIGGSFIELD_API_KEY_ID",
    "resource": "image_credits",
    "purchase": {
      "mode": "slow-lane",
      "realMoney": true,
      "pricingPath": "/pricing",
      "accountPath": "/pricing",
      "accountPaths": [
        "/pricing",
        "/",
        "/account",
        "/dashboard"
      ],
      "balanceSelectors": [
        "[data-testid*='credit' i]",
        "[data-testid*='balance' i]",
        "[aria-label*='credit' i]",
        "[aria-label*='balance' i]"
      ],
      "balanceRevealSelector": "[data-testid*='avatar' i],[data-testid*='user-menu' i],[data-testid*='account' i],[aria-label*='account' i],[aria-label*='profile' i],header button:has(img)",
      "offerEntryPath": "/",
      "offerRevealSelectors": [
        "[data-testid*='avatar' i],[data-testid*='user-menu' i],[data-testid*='account' i],[aria-label*='account' i],[aria-label*='profile' i],header button:has(img)",
        "button:near(:text('Top-up credits'), 400),a:near(:text('Top-up credits'), 400),:text('Top-up credits')"
      ],
      "dismissSelectors": [
        "[role='dialog'] [aria-label*='close' i]",
        "[role='dialog'] button[aria-label*='close' i]",
        "button[aria-label*='close' i]",
        "[aria-label='Close']",
        "[data-testid*='close' i]",
        "[class*='modal' i] button[class*='close' i]",
        "[class*='overlay' i] [aria-label*='close' i]"
      ],
      "loginWallPattern": "^/(login|signin|sign-in|auth)",
      "offersFrom": "catalogue",
      "steelCredentials": true
    },
    "offers": [
      {
        "productId": "higgsfield_credits_100",
        "label": "100 credits",
        "unitsGranted": 100,
        "price": 6.25,
        "currency": "USD",
        "billing": "one_time",
        "autoRenew": false
      },
      {
        "productId": "higgsfield_credits_200",
        "label": "200 credits",
        "unitsGranted": 200,
        "price": 12,
        "currency": "USD",
        "billing": "one_time",
        "autoRenew": false
      },
      {
        "productId": "higgsfield_credits_500",
        "label": "500 credits",
        "unitsGranted": 500,
        "price": 26,
        "currency": "USD",
        "billing": "one_time",
        "autoRenew": false
      }
    ]
  },
  "studio": {
    "description": "Studio: a real image-credits vendor on Stripe TEST mode (npm run vendor:studio). A 402 insufficient_credits sends Aisle to /billing to buy a pack and pay on Stripe Checkout with the test card 4242.",
    "enabledByEnv": "STUDIO_PUBLIC_URL",
    "canonicalOrigin": "${STUDIO_PUBLIC_URL}",
    "billingOrigin": "${STUDIO_PUBLIC_URL}",
    "billingUrl": "${STUDIO_PUBLIC_URL}/billing",
    "toolUrl": "${STUDIO_URL}",
    "authEnv": "STUDIO_API_KEY",
    "resource": "image_credits",
    "purchase": {
      "mode": "slow-lane",
      "realMoney": false,
      "pricingPath": "/billing",
      "accountPath": "/billing",
      "loggedInSelector": "[data-account-email]",
      "loginWallPattern": "^/login",
      "paymentOrigins": [
        "https://checkout.stripe.com"
      ],
      "steelCredentials": true,
      "stripeTestCard": true
    },
    "offers": [
      {
