{
  "openai": {
    "description": "OpenAI API. A key on an account with no credits returns 429 insufficient_quota / credit_balance_exhausted, a real billing wall.",
    "canonicalOrigin": "https://api.openai.com",
    "billingOrigin": "https://platform.openai.com",
    "billingUrl": "https://platform.openai.com/settings/organization/billing/overview",
    "authEnv": "OPENAI_API_KEY",
    "resource": "usd_balance",
    "purchase": {
      "mode": "slow-lane",
      "realMoney": true,
      "pricingPath": "/settings/organization/billing/overview",
      "accountPath": "/settings/organization/billing/overview",
      "loginWallPattern": "^/(login|log-in|signin|auth)",
      "offersFrom": "catalogue"
    },
    "offers": [
      { "productId": "openai_credits_5", "label": "$5 API credits", "unitsGranted": 5, "price": 5, "currency": "USD", "billing": "one_time", "autoRenew": false },
      { "productId": "openai_credits_10", "label": "$10 API credits", "unitsGranted": 10, "price": 10, "currency": "USD", "billing": "one_time", "autoRenew": false },
      { "productId": "openai_credits_25", "label": "$25 API credits", "unitsGranted": 25, "price": 25, "currency": "USD", "billing": "one_time", "autoRenew": false }
    ]
  },
  "higgsfield": {
    "description": "Higgsfield (image/video generation). ⚠ VERIFY origins and error shape against a logged-in account. Its public pricing page sells monthly plans billed annually, which Aisle refuses; one-time credit packs, if offered, sit behind login and are not listed here yet.",
    "canonicalOrigin": "https://platform.higgsfield.ai",
    "billingOrigin": "https://higgsfield.ai",
    "billingUrl": "https://higgsfield.ai/pricing",
    "resource": "image_credits",
    "purchase": {
      "mode": "slow-lane",
      "realMoney": true,
      "pricingPath": "/pricing",
      "accountPath": "/pricing",
      "loginWallPattern": "^/(login|signin|sign-in|auth)"
    },
    "offers": []
  },
  "mockvendor": {
    "description": "Mock image vendor. With `npm run mock:vendor` running, it is a real website Steel buys credits on (fake money). Without it, an in-process mock with example.com as a placeholder billing page.",
    "canonicalOrigin": "${MOCK_VENDOR_PUBLIC_URL:-https://example.com}",
    "billingOrigin": "${MOCK_VENDOR_PUBLIC_URL:-https://example.com}",
    "billingUrl": "${MOCK_VENDOR_PUBLIC_URL:-https://example.com}/pricing",
    "toolUrl": "${MOCK_VENDOR_URL}",
    "resource": "image_credits",
    "purchase": {
      "mode": "slow-lane",
      "realMoney": false,
      "requiresEnv": "MOCK_VENDOR_PUBLIC_URL",
      "mcpUrl": "${MOCK_VENDOR_PUBLIC_URL}/mcp",
      "mcpDialUrl": "${MOCK_VENDOR_URL}/mcp",
      "pricingPath": "/pricing",
      "accountPath": "/account",
      "loggedInSelector": "[data-account-email]"
    },
    "offers": [
      { "productId": "c1000", "label": "1,000 credits", "unitsGranted": 1000, "price": 5, "currency": "USD", "billing": "one_time", "autoRenew": false },
      { "productId": "c5000", "label": "5,000 credits", "unitsGranted": 5000, "price": 20, "currency": "USD", "billing": "one_time", "autoRenew": false },
      { "productId": "c25000", "label": "25,000 credits", "unitsGranted": 25000, "price": 80, "currency": "USD", "billing": "one_time", "autoRenew": false }
    ]
  }
}
