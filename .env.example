# Copy to .env (gitignored) and fill in. Loaded via: node --env-file=.env ...
# Names follow docs/aisle-scaffold.zip → aisle/.env.example. The mock demos need none of these.

# ---- core ----
MANDATE_SECRET=dev-only-change-me     # HMAC key for signing/verifying purchase mandates

# ---- ceilings (USD) — docs/aisle-pipeline.md §10, §16.6 ----
LIMIT_PER_PURCHASE=50
LIMIT_PER_TASK=100
LIMIT_PER_DAY=250
MAX_PURCHASE_ATTEMPTS_PER_TASK=3
MAX_RESOLVER_CALLS_PER_JOB=5

# ---- steel — docs/steel.md §3 ----
STEEL_API_KEY=                        # https://app.steel.dev (Settings → API Keys)
STEEL_SESSION_TIMEOUT_MS=900000       # 15 min. Asserted at session create. Cannot be raised later.
# STEEL_DEDICATED_IP_ID=fixed:xxxx    # Settings → Network (paid plans). Pins profiles with no IP yet — steel.md §6, §9.

# ---- openrouter: TWO SEPARATE KEYS — docs/aisle-pipeline.md §16.5 ----
OPENROUTER_INFRA_KEY=                 # drives the computer-use resolver. NEVER recoverable.
OPENROUTER_DEMO_KEY=                  # drained on purpose. This is the vendor Aisle recovers.
# OPENROUTER_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free   # default; must accept images

# ---- MCP gateway (src/gateway) ----
OPENAI_API_KEY=                       # openai__chat. Blank → 401, passed through. No-credit key → 429 insufficient_quota → recovery.
# SAFE_BLOCK_MS=50000                 # how long a blocked tool call holds open; keep under the agent's tool timeout
# AISLE_APPROVAL_PORT=8787            # local approval page
# AISLE_OPEN_APPROVAL=1               # 0 = don't open the approval page in the browser
# AISLE_STEEL_HOLD_MS=15000           # keep the Steel session open this long to watch it
# AISLE_STEEL_PROXY_CAPTCHA=0         # 1 = proxies + captcha solving (needs paid Steel balance)
# AISLE_MOCK_START_BALANCE=0          # mock vendor starting credits

# ---- optional ----
# STEEL_SMOKE_URL=https://example.com # target for npm run smoke:steel
