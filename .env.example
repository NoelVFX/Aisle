# Copy to .env (gitignored) and fill in. Loaded via: node --env-file=.env ...
# Only the SLOW lane's SteelBrowserProvider needs this; the mock demos do not.

# Steel Cloud API key — https://app.steel.dev (Settings → API Keys)
STEEL_API_KEY=

# Computer-use fallback model (slow lane only; NOT needed for the core demo).
# Pick ONE provider for the injected ComputerUseAgent:

# OpenRouter (free vision models available) — createOpenRouterComputerUseAgent()
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Anthropic — only if you use the Anthropic computer-use reference agent.
# ANTHROPIC_API_KEY=
