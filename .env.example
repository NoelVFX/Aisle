# ---------------------------------------------------------------------------
# Database (Supabase Postgres) — from Supabase dashboard → Settings → Database
# ---------------------------------------------------------------------------
# Pooled connection (Transaction pooler, port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Direct connection (Session mode, port 5432) — used only for migrations.
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase Auth / client — from Supabase dashboard → Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# Anon/public key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY="anon-key-from-supabase-dashboard"
# Service role key — server-only, NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY="service-role-key-from-supabase-dashboard"
